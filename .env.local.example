# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Resend API key — create an account at https://resend.com and generate
# an API key under Settings > API Keys.
RESEND_API_KEY=

# Where contact form submissions get emailed.
CONTACT_TO_EMAIL=admin@channelmarkshell.com

# Sender address for outgoing emails. The default (onboarding@resend.dev)
# works immediately with no setup, but Resend will only deliver it to the
# email address on your Resend account — not to CONTACT_TO_EMAIL above.
# Once you verify a domain (e.g. channelmarkshell.com) in Resend, set this
# to an address on that domain (e.g. website@channelmarkshell.com) to send
# to any recipient.
CONTACT_FROM_EMAIL=onboarding@resend.dev
